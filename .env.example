# Copy this file to .env and fill it in. The agent (agent.py) reads it; every key stays on the
# machine that runs the agent.

# From https://app.simli.com (API key in your profile).
SIMLI_API_KEY=

# From your LiveKit Cloud project's settings (https://cloud.livekit.io), or a
# self-hosted LiveKit server with a public address: Simli's servers join the room.
# Copy the same three values to frontend/.env.local.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text, from https://console.deepgram.com.
DEEPGRAM_API_KEY=

# The LLM, from https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Text-to-speech, from https://elevenlabs.io/app/settings/api-keys.
ELEVENLABS_API_KEY=

# Optional: any Trinity-2 face ID. Defaults to Simli's default Trinity-2 face,
# 14c60d62-6ebf-424d-b626-1f4f91c33b04 (a woman). Match the voice to the face.
SIMLI_FACE_ID=

# Optional: any voice from your ElevenLabs voice library. Defaults to the premade voice
# "Jessica" (cgSgspJ2msm6clMCkdW9, female), to match the default face.
ELEVENLABS_VOICE_ID=

# Optional: the OpenAI chat model. Defaults to gpt-6-luna with reasoning off ("none"), for the
# fastest replies. For a model without reasoning support (e.g. gpt-4.1-mini), also set
# OPENAI_REASONING_EFFORT=off.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=

# Optional: OpenAI's service tier. Defaults to "fast": about 2x the token price, and replies start
# up to a second sooner. Set "default" for the standard tier (cheaper, slower), or if your model
# doesn't offer the fast tier.
OPENAI_SERVICE_TIER=

# Optional: Deepgram's endpoint. Defaults to the US one. If the agent runs in Europe, use
# https://api.eu.deepgram.com/v1/listen (about 150 ms faster).
DEEPGRAM_BASE_URL=

# Optional: the name the agent registers under. Defaults to simli-pipeline-agent. If you change
# it, set the same LIVEKIT_AGENT_NAME in frontend/.env.local.
LIVEKIT_AGENT_NAME=
