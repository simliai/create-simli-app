# Copy to .env and fill in. Every value is read by the server only (server.ts):
# never prefix keys with NEXT_PUBLIC_, which would ship them to the browser.

# --- Required -----------------------------------------------------------------
# https://app.simli.com (API key section of the dashboard)
SIMLI_API_KEY=
# https://console.deepgram.com
DEEPGRAM_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://elevenlabs.io/app/settings/api-keys (streaming TTS needs a paid plan)
ELEVENLABS_API_KEY=

# --- Avatar and voice (optional) ------------------------------------------------
# Simli's default Trinity-2 face (a woman). Other presets: https://docs.simli.com/api-reference/preset-faces
SIMLI_FACE_ID=14c60d62-6ebf-424d-b626-1f4f91c33b04
# Any voice from your ElevenLabs voice library. Default: premade "Jessica" (female).
# Match the voice to the face: if you change one, check the other.
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# OPENAI_MODEL=gpt-6-luna
# "none" for the fastest replies; set to "off" for models without reasoning support
# OPENAI_REASONING_EFFORT=none
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# --- Server and limits (optional) -----------------------------------------------
# PORT=3000
# Interface to listen on. Development defaults to 127.0.0.1 (this machine only);
# production listens on all interfaces unless set.
# HOST=127.0.0.1
# Production refuses to mint sessions until you add authentication (see the TODO
# in server.ts). Set to true only for a private test deployment.
# ALLOW_UNAUTHENTICATED_SESSIONS=false
# Log what the user and the avatar say. Default: on in development, off in production.
# LOG_TRANSCRIPTS=0
# Comma-separated origins allowed to use the API and WebSocket.
# Defaults to http://localhost:$PORT. Set it to your site's origin in production.
# ALLOWED_ORIGINS=https://avatar.example.com
# MAX_CONCURRENT_SESSIONS=5
# MAX_SESSIONS_PER_IP=2
# Simli session bounds, in seconds
# SIMLI_MAX_SESSION_LENGTH=600
# SIMLI_MAX_IDLE_TIME=180
