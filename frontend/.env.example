# Copy this file to .env.local. Use the same three LiveKit values as the agent's .env.
# They stay on the server: only app/api/token/route.ts reads them.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the agent's name, if you changed it with LIVEKIT_AGENT_NAME in the agent's .env.
# Defaults to simli-pipeline-agent.
LIVEKIT_AGENT_NAME=

# Production builds (`npm run build` + `npm start`, or a deployed host) refuse to mint tokens,
# because /api/token has no login and every token starts a billed session. Add your own auth to
# app/api/token/route.ts. For a demo or internal network only, set this to true to allow anyone
# who can reach the page to start sessions.
ALLOW_UNAUTHENTICATED_SESSIONS=
